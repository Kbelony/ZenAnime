{
  "headers": [
    {
      "source": "/api/stream/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://zenanime-topaz.vercel.app" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/stream/:animeId/:episode", "destination": "/api/stream/[animeId]/[episode].ts" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
